<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.1</TargetFramework>
		<LangVersion>12</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>

		<Version>0.1.1</Version>
		<Authors>RafaelEstevam.Net</Authors>
		<Company>RafaelEstevam.Net</Company>
		<Product>Simple C# personal finance manager</Product>
		<Description>Simple C# personal finance manager</Description>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/RafaelEstevamReis/SimpleFinance</PackageProjectUrl>
		<RepositoryUrl>https://github.com/RafaelEstevamReis/SimpleFinance</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>Simple API Finance Manager</PackageTags>
		<PackageReleaseNotes>See examples and documentation on the GitHub page https://github.com/RafaelEstevamReis/SimpleFinance</PackageReleaseNotes>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="RafaelEstevam.TextSerializer" Version="0.5.1" />
	  <PackageReference Include="Simple.Sqlite" Version="1.4.9.1" />
	</ItemGroup>

</Project>
